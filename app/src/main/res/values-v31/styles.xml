<resources>
 <style name="Theme.OTRDial" parent="Theme.MaterialComponents.DayNight.NoActionBar">
  <item name="colorPrimary">@color/otr_brown</item><item name="colorSecondary">@color/otr_gold</item>
  <item name="android:windowSplashScreenBackground">@color/otr_cream</item><item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_brand</item>
  <item name="android:fontFamily">sans</item><item name="android:windowBackground">@color/otr_cream</item>
  <item name="android:windowLightStatusBar">@bool/light_system_bars</item><item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
  <item name="android:statusBarColor">@android:color/transparent</item><item name="android:navigationBarColor">@android:color/transparent</item>
 </style>
 <style name="GlassButton" parent="Widget.AppCompat.Button.Borderless">
  <item name="android:background">@drawable/glass_panel</item><item name="android:textColor">@color/otr_ink</item>
  <item name="android:textAllCaps">false</item><item name="android:minHeight">48dp</item><item name="android:minWidth">0dp</item><item name="android:paddingHorizontal">12dp</item><item name="android:textSize">13sp</item>
 </style>
 <style name="NavButton" parent="GlassButton"><item name="android:background">?attr/selectableItemBackgroundBorderless</item><item name="android:textSize">11sp</item><item name="android:paddingHorizontal">2dp</item><item name="android:drawablePadding">3dp</item></style>
 <style name="Heading"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:textColor">@color/otr_ink</item><item name="android:textSize">21sp</item><item name="android:textStyle">bold</item><item name="android:layout_marginTop">20dp</item><item name="android:layout_marginBottom">12dp</item></style>
</resources>