<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="10dp"
    android:layout_marginVertical="3dp"
    android:background="@color/otr_panel">

    <TextView
        android:id="@+id/stationInitials"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:textStyle="bold"
        android:textSize="14sp"
        android:textColor="@color/otr_cream"
        android:background="@color/otr_brown" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp">

        <TextView
            android:id="@+id/stationName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textColor="@color/otr_ink"
            android:textSize="16sp"
            android:maxLines="1" />

        <TextView
            android:id="@+id/stationDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/otr_muted"
            android:textSize="12sp"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/favMark"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:gravity="center"
        android:text="♡"
        android:textSize="24sp"
        android:textColor="@color/otr_gold" />

    <TextView
        android:id="@+id/infoMark"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:gravity="center"
        android:text="ⓘ"
        android:textSize="22sp"
        android:textColor="@color/otr_muted"
        android:contentDescription="Station details" />
</LinearLayout>
