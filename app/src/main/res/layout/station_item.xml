<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="10dp" android:layout_marginVertical="5dp" android:background="@drawable/glass_panel">
 <ImageView android:id="@+id/stationInitials" android:layout_width="60dp" android:layout_height="76dp" android:scaleType="centerCrop" android:clipToOutline="true" android:background="@drawable/glass_panel" android:importantForAccessibility="no"/>
 <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingHorizontal="12dp">
 <TextView android:id="@+id/stationName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" android:textColor="@color/otr_ink" android:textSize="16sp"/>
 <TextView android:id="@+id/stationDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/otr_muted" android:textSize="12sp" android:layout_marginTop="6dp"/>
 </LinearLayout>
 <TextView android:id="@+id/favMark" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="♡" android:textSize="25sp" android:textColor="@color/otr_gold"/>
 <TextView android:id="@+id/infoMark" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="⋮" android:textSize="25sp" android:textColor="@color/otr_muted" android:contentDescription="Station details"/>
 </LinearLayout>