<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/aurora">
 <LinearLayout android:id="@+id/appHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="20dp" android:paddingVertical="12dp" android:gravity="center_vertical">
 <ImageView android:layout_width="32dp" android:layout_height="40dp" android:src="@drawable/ic_wave" android:importantForAccessibility="no"/>
 <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="10dp">
 <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OTR Dial" android:textColor="@color/otr_ink" android:textStyle="bold" android:textSize="25sp"/>
 <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GREAT STORIES. ALWAYS ON." android:textColor="@color/otr_muted" android:textSize="9sp" android:letterSpacing="0.12"/>
 </LinearLayout><com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/themeSwitch" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Dark" android:textColor="@color/otr_ink" android:contentDescription="Dark mode"/>
 </LinearLayout>
 <LinearLayout android:id="@+id/browserPanel" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
 <ScrollView android:id="@+id/homeScreen" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/hero_gradient" android:padding="20dp" android:gravity="center_vertical">
 <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
 <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="YOUR THEATRE OF THE MIND" android:textColor="#FFE6FA" android:textSize="10sp" android:letterSpacing="0.08"/>
 <TextView android:id="@+id/heroTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Extraordinary
stories await." android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="26sp" android:paddingVertical="10dp"/>
 <TextView android:id="@+id/heroSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="A little mystery. A little magic." android:textColor="#F5DEFF" android:textSize="13sp"/>
 <androidx.appcompat.widget.AppCompatButton android:id="@+id/heroPlay" style="@style/GlassButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▶  Listen now" android:layout_marginTop="14dp" android:background="@drawable/accent_gradient" android:textColor="#FFFFFF"/>
 </LinearLayout><ImageView android:id="@+id/heroArt" android:layout_width="94dp" android:layout_height="146dp" android:layout_marginStart="12dp" android:scaleType="centerCrop" android:background="@drawable/glass_panel" android:clipToOutline="true" android:importantForAccessibility="no"/>
 </LinearLayout>
 <androidx.appcompat.widget.AppCompatButton android:id="@+id/episodeLibraryButton" style="@style/GlassButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:text="Your listening library  ›\nPodcasts • Archive episodes • Resume" android:layout_marginTop="12dp" android:textSize="16sp"/>
 <TextView style="@style/Heading" android:text="Featured stations"/>
 <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none"><LinearLayout android:id="@+id/featuredCards" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"/></HorizontalScrollView>
 <TextView style="@style/Heading" android:text="Find your kind of story"/>
 <LinearLayout android:id="@+id/genreCards" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
 <TextView style="@style/Heading" android:text="Recently played"/>
 <LinearLayout android:id="@+id/recentCards" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
 <androidx.appcompat.widget.AppCompatButton android:id="@+id/recentButton" style="@style/GlassButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="See all recently played" android:layout_marginTop="8dp"/>
 </LinearLayout></ScrollView>
 <LinearLayout android:id="@+id/exploreScreen" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone" android:paddingHorizontal="16dp">
 <EditText android:id="@+id/searchBox" android:layout_width="match_parent" android:layout_height="52dp" android:hint="Search stations, networks, genres…" android:textSize="15sp" android:singleLine="true" android:inputType="text" android:paddingHorizontal="18dp" android:textColor="@color/otr_ink" android:textColorHint="@color/otr_muted" android:background="@drawable/glass_panel"/>
 <Spinner android:id="@+id/collectionSpinner" android:layout_width="match_parent" android:layout_height="48dp" android:visibility="gone"/>
 <Spinner android:id="@+id/genreSpinner" android:layout_width="match_parent" android:layout_height="48dp"/>
 <Spinner android:id="@+id/networkSpinner" android:layout_width="match_parent" android:layout_height="48dp"/>
 <TextView android:id="@+id/listSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="8dp" android:textColor="@color/otr_muted"/>
 <androidx.recyclerview.widget.RecyclerView android:id="@+id/stationList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="12dp"/>
 </LinearLayout></LinearLayout>
 <ScrollView android:id="@+id/playerScreen" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:visibility="gone" android:fillViewport="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:gravity="center_horizontal">
 <androidx.appcompat.widget.AppCompatButton android:id="@+id/backButton" style="@style/GlassButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⌄  Back to stations" android:layout_gravity="start"/>
 <ImageView android:id="@+id/playerArtwork" android:layout_width="match_parent" android:layout_height="280dp" android:scaleType="fitCenter" android:layout_marginVertical="12dp" android:padding="12dp" android:background="@drawable/glass_panel" android:clipToOutline="true" android:importantForAccessibility="no"/>
 <TextView android:id="@+id/onAirLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="OTR DIAL" android:textSize="11sp" android:letterSpacing="0.12" android:textColor="@color/otr_gold"/>
 <TextView android:id="@+id/currentStation" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Choose a station" android:textStyle="bold" android:textSize="28sp" android:textColor="@color/otr_ink" android:paddingTop="8dp"/>
 <TextView android:id="@+id/currentMetadata" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="17sp" android:textColor="@color/otr_ink" android:paddingVertical="12dp"/>
 <TextView android:id="@+id/metadataSource" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/otr_muted"/>
 <TextView android:id="@+id/connectionStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Choose a station" android:textColor="@color/otr_gold" android:paddingVertical="10dp" android:accessibilityLiveRegion="polite"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:paddingVertical="10dp">
 <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/previousStation" android:layout_width="56dp" android:layout_height="56dp" android:padding="15dp" android:src="@drawable/ic_previous" android:contentDescription="Previous station" android:background="@drawable/glass_panel"/>
 <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/playPauseButton" android:layout_width="88dp" android:layout_height="88dp" android:layout_marginHorizontal="16dp" android:padding="26dp" android:src="@drawable/ic_play" android:contentDescription="Play" android:background="@drawable/accent_gradient" app:tint="#FFFFFF"/>
 <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/nextStation" android:layout_width="56dp" android:layout_height="56dp" android:padding="15dp" android:src="@drawable/ic_next" android:contentDescription="Next station" android:background="@drawable/glass_panel"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"><androidx.appcompat.widget.AppCompatButton android:id="@+id/favouriteButton" style="@style/GlassButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="♡" android:layout_marginEnd="8dp" android:textSize="24sp" android:contentDescription="Add to favourites"/><androidx.appcompat.widget.AppCompatButton android:id="@+id/recordButton" style="@style/GlassButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="● Record" android:layout_marginEnd="8dp"/><androidx.appcompat.widget.AppCompatButton android:id="@+id/shareButton" style="@style/GlassButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Share" /></LinearLayout>
 <TextView style="@style/Heading" android:text="About this station"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"><androidx.appcompat.widget.AppCompatButton android:id="@+id/scheduleButton" style="@style/GlassButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Details / schedule" android:layout_marginEnd="8dp"/><androidx.appcompat.widget.AppCompatButton android:id="@+id/checkStreamButton" style="@style/GlassButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Check connection" /></LinearLayout><androidx.appcompat.widget.AppCompatButton android:id="@+id/artworkCredits" style="@style/GlassButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Artwork credits" android:layout_marginTop="10dp" android:layout_gravity="start"/>
 </LinearLayout></ScrollView>
 <LinearLayout android:id="@+id/miniPlayer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="12dp" android:layout_marginVertical="6dp" android:padding="8dp" android:gravity="center_vertical" android:background="@drawable/glass_panel" android:visibility="gone">
 <ImageView android:id="@+id/miniArtwork" android:layout_width="44dp" android:layout_height="52dp" android:scaleType="centerCrop" android:background="@drawable/glass_panel" android:clipToOutline="true" android:importantForAccessibility="no"/>
 <androidx.appcompat.widget.AppCompatButton android:id="@+id/openPlayerButton" style="@style/NavButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="52dp" android:gravity="start|center_vertical" android:paddingHorizontal="12dp" android:textSize="14sp" android:text="Open player"/>
 <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/miniPlayPause" android:layout_width="48dp" android:layout_height="48dp" android:padding="14dp" android:src="@drawable/ic_play" android:contentDescription="Play" android:background="@drawable/accent_gradient" app:tint="#FFFFFF"/>
 </LinearLayout>
 <LinearLayout android:id="@+id/navigationBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/glass_panel" android:paddingTop="6dp" android:paddingHorizontal="8dp" android:gravity="center_vertical">
 <androidx.appcompat.widget.AppCompatButton android:id="@+id/homeButton" style="@style/NavButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="64dp" android:text="Home" android:drawableTop="@drawable/ic_home"/><androidx.appcompat.widget.AppCompatButton android:id="@+id/exploreButton" style="@style/NavButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="64dp" android:text="Explore" android:drawableTop="@drawable/ic_explore"/><androidx.appcompat.widget.AppCompatImageButton android:id="@+id/navPlayer" android:layout_width="52dp" android:layout_height="52dp" android:padding="15dp" android:src="@drawable/ic_play" android:contentDescription="Open player" android:background="@drawable/accent_gradient" app:tint="#FFFFFF"/><androidx.appcompat.widget.AppCompatButton android:id="@+id/favouritesButton" style="@style/NavButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="64dp" android:text="Favourites" android:drawableTop="@drawable/ic_heart"/><androidx.appcompat.widget.AppCompatButton android:id="@+id/settingsButton" style="@style/NavButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="64dp" android:text="Settings" android:drawableTop="@drawable/ic_settings"/>
 </LinearLayout></LinearLayout>
