<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:background="@color/otr_cream">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp">
  <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="OTR DIAL" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/otr_ink" android:paddingVertical="16dp"/>
  <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/themeSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Dark mode" android:textColor="@color/otr_ink"/>
 </LinearLayout>
 <LinearLayout android:id="@+id/browserPanel" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
  <Spinner android:id="@+id/collectionSpinner" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginHorizontal="12dp"/>
  <TextView android:id="@+id/listSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="16dp" android:textColor="@color/otr_muted" android:paddingBottom="4dp"/>
  <EditText android:id="@+id/searchBox" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginHorizontal="16dp" android:hint="@string/search_hint" android:singleLine="true" android:inputType="text" android:paddingHorizontal="12dp" android:textColor="@color/otr_ink" android:textColorHint="@color/otr_muted" android:backgroundTint="@color/otr_brown"/>
  <Spinner android:id="@+id/genreSpinner" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginHorizontal="12dp"/>
  <androidx.recyclerview.widget.RecyclerView android:id="@+id/stationList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingHorizontal="8dp" android:paddingBottom="8dp" android:clipToPadding="false"/>
  <Button android:id="@+id/openPlayerButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginHorizontal="12dp" android:layout_marginBottom="8dp" android:text="Open player" android:textAllCaps="false" android:visibility="gone"/>
 </LinearLayout>
 <ScrollView android:id="@+id/playerScreen" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:visibility="gone">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:gravity="center_horizontal">
   <Button android:id="@+id/backButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_gravity="start" android:text="‹ Stations" android:textAllCaps="false"/>
   <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>
   <TextView android:layout_width="160dp" android:layout_height="160dp" android:gravity="center" android:text="OTR" android:textSize="44sp" android:textStyle="bold" android:textColor="@color/otr_ink" android:background="@color/otr_panel" android:layout_marginVertical="24dp" android:importantForAccessibility="no"/>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="LIVE RADIO" android:textSize="12sp" android:letterSpacing="0.15" android:textColor="@color/otr_muted" android:gravity="center"/>
   <TextView android:id="@+id/currentStation" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/nothing_playing" android:textStyle="bold" android:textSize="26sp" android:textColor="@color/otr_ink" android:gravity="center" android:paddingTop="12dp"/>
   <TextView android:id="@+id/currentMetadata" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/now_playing" android:textSize="16sp" android:textColor="@color/otr_muted" android:gravity="center" android:paddingVertical="16dp"/>
   <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/playPauseButton" android:layout_width="88dp" android:layout_height="88dp" android:src="@drawable/ic_play" android:contentDescription="Play" android:padding="20dp" android:background="?attr/selectableItemBackgroundBorderless"/>
   <TextView android:id="@+id/connectionStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/otr_muted" android:gravity="center" android:accessibilityLiveRegion="polite" android:text="Choose a station"/>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:paddingVertical="16dp">
    <Button android:id="@+id/favouriteButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="56dp" android:text="♡" android:textSize="24sp" android:contentDescription="Add to favourites"/>
    <Button android:id="@+id/recordButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="56dp" android:text="● REC" android:layout_marginStart="12dp"/>
   </LinearLayout>
   <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>
  </LinearLayout>
 </ScrollView>
</LinearLayout>
